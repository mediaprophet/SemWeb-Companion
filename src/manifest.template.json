{
  "manifest_version": 3,
  "name": "SemWeb Companion",
  "short_name": "SDS Fork",
  "version": "3.0.0.1",
  "description": "Explore, preview, and export all semantic and linked data (JSON-LD, Microdata, RDFa, Turtle, CSV, and more) embedded in web pages. Designed for the Semantic Web and Social Web, with rich previews, sharing, accessibility, and developer tools.",
  "author": "SemWeb Companion Community",
  "homepage_url": "https://github.com/mediaprophet/semweb-companion",
  "minimum_chrome_version": "88",
  "icons": {
    "16": "images/icon16.png",
    "48": "images/icon48.png",
    "128": "images/icon128.png"
  },
  "action": {
    "default_icon": "images/icon16.png",
    "default_title": "Show Document Metadata",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "declarativeNetRequest",
    "contextMenus"
  ],
  "host_permissions": [
    "*://*/*",
    "file:///*"
  ],
  "options_page": "index.html",
  "web_accessible_resources": [
    {
      "resources": [
        "images/*",
        "assets/*",
        "popup.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; style-src 'self' 'unsafe-inline' https://solid.openlinksw.com; media-src 'self';"
  },
  "side_panel": {
    "default_path": "sidebar.html"
  }
}
