{
  "name": "Structured Data Sniffer (Community Fork)",
  "short_name": "SDS Fork",
  "author": "Structured Data Sniffer Community",
  "homepage_url": "https://github.com/mediaprophet/structured-data-sniffer",
  "version": "3.0.0.1",
  "manifest_version": 3,
  "minimum_chrome_version": "88",
  "description": "Explore, preview, and export all structured data (JSON-LD, Microdata, RDFa, Turtle, CSV, and more) embedded in web pages. Designed for the Web of Data and Social Web, with rich previews, sharing, accessibility, and developer tools.",
  "icons": {
      "16":  "images/icon16.png",
      "48":  "images/icon48.png",
      "128": "images/icon128.png" },
  "action": {
    "default_icon": "images/icon16.png",
    "default_title": "Show Document Metadata",
    "default_popup": "popup.html"
  },
  "permissions": [
    "storage",
    "declarativeNetRequest",
    "contextMenus"
  ],
  "host_permissions": [
    "*://*/*",
    "file:///*"
  ],
  "options_page": "index.html",
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; style-src 'self' 'unsafe-inline' https://solid.openlinksw.com; media-src 'self';"
  },
  "side_panel": {
    "default_path": "sidebar.html"
  }

}
